node_modules/
.env
.env.*
!.env.example
.DS_Store

# Lokale state — per machine. Mag niet in git anders worden ze overschreven bij git reset.
# De Pi is de bron van waarheid voor al deze bestanden (zie deploy.sh / PI_EIGEN).
members.json
scores.json
geschiedenis.json
stemmen.json
streaks.json
achievements.json
verbanning.json
test_kanalen.json
instellingen.json
personas.json

# Overige runtime-state en opgebouwde inhoud. Bevat ledengegevens en uitspraken van leden,
# dus hoort niet in git — en zou bij een git reset de echte stand overschrijven.
roem.json
allianties.json
geleKaarten.json
vergrijpen.json
weekgebeurtenissen.json
eerGegeven.json
verdacht.json
missie.json
powerups.json
winkelhistorie.json
statistiekhistorie.json
geplandeberichten.json
overslaan.json
auditlog.json
llmstats.json
frituurlog.json
kennisbank.json
quiz.json
profetie.json
kroketgok.json
kroket_van_de_dag.json
goudenkroket.json
troon.json
troonduel.json
cooldowns.json
duels.json
vetbad.json
bingo.json
veiling.json
bamischijf.json
premie.json
profeet.json
weekreset.json
kroketevent.json
geluk.json
opdrachten.json

tellers.json

# Ambten en het Vetgeschrift: houderschap, zegels, het openbare ambtsboek en het rollende
# tellervenster waaruit de aanspraak wordt berekend. Zelfde reden als hierboven — dit is de
# echte stand op de Pi en een git reset mag hem niet overschrijven.
ambten.json
ambtsboek.json
venstertellers.json
openbaring.json

# Permanent prestige dat een deploy nooit mag overschrijven. Stond er nog niet in, terwijl
# roem.json en tellers.json hier wél om precies die reden staan.
titels.json
heldentitels.json
duelhistorie.json

# Het Grote Archief: elk bericht dat ooit in het kanaal stond. Puur ledengegevens, groeit
# eeuwig door en de Pi is de enige echte bron — die mag een git reset nooit overschrijven.
grootarchief.ndjson

# De Voorraadkelder: vooruit gegenereerde kanaalinhoud, per machine en per dag.
voorraad.json

# De Frituurbeurs: posities per week. Geheim voor de leden onderling.
beurs.json

# Backups bevatten kopieën van alle ledengegevens
backups/

# Claude Code: lokale (machine-specifieke) instellingen
.claude/settings.local.json
vetbadoverride.json

# Het Gefluisterde Voorrecht: openstaande eenmalige tekens. Hoort nergens buiten de Pi.
fortuin.json

# De galerij der visioenen: genummerde beelden met hun titels en Slack-file-id's.
visioenen.json

# Het Verhoor: gebruikte citaten en de lopende ronde.
verhoor.json

# De Kroketkroniek: afleveringen van het feuilleton.
kroniek.json

# Het Sociale Weefsel: gerichte relatietellers per ledenpaar.
weefsel.json

# De Tijdcapsule: verzegelde en beoordeelde voorspellingen.
tijdcapsule.json

# De Hoge Frituurraad: het register van gewezen zaken.
jurisprudentie.json
