SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
GROQ_API_KEY=gsk_...

# Dashboard op poort 3001. Verplicht: zonder dit token weigert het dashboard élk verzoek (401),
# inclusief /api/stats met de ledengegevens. Genereer er een met: openssl rand -hex 16
DASHBOARD_TOKEN=

# Beeldgeneratie: model van Nano Banana (leeg = gemini-2.5-flash-image). Pollinations-vangnet uit met 1.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# POLLINATIONS_IMAGE_MODEL=flux
# POLLINATIONS_UIT=0

# Groq-modellen (Groq zet modellen zonder aankondiging uit; lijst: GET https://api.groq.com/openai/v1/models)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_LICHT=openai/gpt-oss-20b
